{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.dev/schemas/2.1/plan.schema.json",
  "title": "Frozen logical case plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/caseId"
          },
          "feature_id": {
            "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/featureId"
          },
          "scenario": {
            "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/scenario"
          },
          "effective_tier": {
            "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/baseTier"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "case_id",
          "feature_id",
          "scenario",
          "effective_tier"
        ],
        "additionalProperties": false
      }
    },
    "frozen_at": {
      "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/isoTimestamp"
    }
  },
  "required": [
    "schema_version",
    "cases",
    "frozen_at"
  ],
  "additionalProperties": false
}
