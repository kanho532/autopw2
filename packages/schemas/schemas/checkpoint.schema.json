{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.dev/schemas/2.1/checkpoint.schema.json",
  "title": "Execution instance atomic checkpoint",
  "type": "object",
  "properties": {
    "execution_id": {
      "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/executionId"
    },
    "case_id": {
      "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/caseId"
    },
    "status": {
      "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/executionStatus"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "at": {
      "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/isoTimestamp"
    }
  },
  "required": [
    "execution_id",
    "case_id",
    "status",
    "at"
  ],
  "additionalProperties": false
}
