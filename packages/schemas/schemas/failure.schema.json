{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.dev/schemas/2.1/failure.schema.json",
  "title": "Fatal failure record",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
    },
    "run_id": {
      "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/runId"
    },
    "fatal_class": {
      "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/fatalFailureClass"
    },
    "error": {
      "type": "object",
      "additionalProperties": true
    },
    "at": {
      "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/isoTimestamp"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "fatal_class",
    "error",
    "at"
  ],
  "additionalProperties": false
}
