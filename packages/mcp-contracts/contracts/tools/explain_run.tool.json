{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.dev/contracts/2.1/tools/explain_run.tool.json",
  "name": "explain_run",
  "description": "Return a bounded explain view: CDD, case birth certificate, issue evidence and gate reason. Page content and descriptions are escaped; no host absolute paths are returned.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://autopw.dev/contracts/2.1/tools/explain_run.tool.json#/input",
    "title": "explain_run input",
    "description": "Explain query",
    "type": "object",
    "properties": {
      "schema_version": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
      },
      "workspace_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/workspaceId"
      },
      "run_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/runId"
      },
      "focus_case_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/caseId"
      },
      "page": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "schema_version",
      "workspace_id",
      "run_id"
    ],
    "additionalProperties": false
  },
  "result_union": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "ok"
        },
        "schema_version": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
        },
        "run_id": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/runId"
        },
        "gate": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/gate"
        },
        "audit_status": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/auditStatus"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/artifactRef"
          }
        }
      },
      "required": [
        "kind",
        "schema_version",
        "run_id"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "https://autopw.dev/schemas/2.1/mcp-error-envelope.schema.json"
    }
  ],
  "creates_operation": false,
  "requires_client_request_id": false,
  "async_default": false,
  "retryable": true,
  "authorization_scope": [
    "workspace"
  ],
  "returns_max_bytes": 524288,
  "examples": {
    "request": [
      {
        "schema_version": "2.1",
        "workspace_id": "ws_demo",
        "run_id": "run_0123456789abcdefghij"
      }
    ],
    "ok": [
      {
        "kind": "ok",
        "schema_version": "2.1",
        "run_id": "run_0123456789abcdefghij",
        "gate": "incomplete",
        "audit_status": "INCOMPLETE",
        "cases": [
          {
            "case_id": "case_search_normal",
            "reason": "test_defect"
          }
        ],
        "evidence_refs": []
      }
    ],
    "error": [
      {
        "kind": "error",
        "schema_version": "2.1",
        "error": {
          "code": "RUN_FORBIDDEN",
          "message": "handle not bound to this workspace"
        },
        "retryable": false
      }
    ]
  }
}
