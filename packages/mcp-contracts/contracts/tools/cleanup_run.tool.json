{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.dev/contracts/2.1/tools/cleanup_run.tool.json",
  "name": "cleanup_run",
  "description": "Idempotently clean up Seed data, temporary browser data and artifacts that satisfy the retention policy. Does not modify a frozen gate.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://autopw.dev/contracts/2.1/tools/cleanup_run.tool.json#/input",
    "title": "cleanup_run input",
    "description": "Cleanup request",
    "type": "object",
    "properties": {
      "schema_version": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
      },
      "client_request_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/clientRequestId"
      },
      "workspace_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/workspaceId"
      },
      "run_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/runId"
      }
    },
    "required": [
      "schema_version",
      "client_request_id",
      "workspace_id",
      "run_id"
    ],
    "additionalProperties": false
  },
  "result_union": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "accepted"
        },
        "schema_version": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
        },
        "operation_id": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/operationId"
        },
        "poll_after_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "run_id": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/runId"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "operation_id",
        "poll_after_ms",
        "run_id"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "https://autopw.dev/schemas/2.1/mcp-error-envelope.schema.json"
    }
  ],
  "creates_operation": true,
  "requires_client_request_id": true,
  "async_default": true,
  "retryable": true,
  "authorization_scope": [
    "workspace"
  ],
  "returns_max_bytes": 524288,
  "examples": {
    "request": [
      {
        "schema_version": "2.1",
        "client_request_id": "cr_cln1",
        "workspace_id": "ws_demo",
        "run_id": "run_0123456789abcdefghij"
      }
    ],
    "ok": [
      {
        "kind": "accepted",
        "schema_version": "2.1",
        "operation_id": "op_0123456789abcdefghij",
        "run_id": "run_0123456789abcdefghij",
        "poll_after_ms": 1000
      }
    ],
    "error": [
      {
        "kind": "error",
        "schema_version": "2.1",
        "error": {
          "code": "RUN_FORBIDDEN",
          "message": "handle not bound to this workspace"
        },
        "retryable": false
      }
    ]
  }
}
