{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.dev/contracts/2.1/tools/get_operation_status.tool.json",
  "name": "get_operation_status",
  "description": "Query status of a preview/resume/cancel/cleanup Operation. Read-only: does not lease, advance phase or resume.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://autopw.dev/contracts/2.1/tools/get_operation_status.tool.json#/input",
    "title": "get_operation_status input",
    "description": "Operation status query",
    "type": "object",
    "properties": {
      "schema_version": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
      },
      "workspace_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/workspaceId"
      },
      "operation_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/operationId"
      }
    },
    "required": [
      "schema_version",
      "workspace_id",
      "operation_id"
    ],
    "additionalProperties": false
  },
  "result_union": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "ok"
        },
        "schema_version": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
        },
        "operation_id": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/operationId"
        },
        "status": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/operationStatus"
        },
        "label": {
          "type": "string",
          "description": "human-readable"
        },
        "poll_after_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "schema_version",
        "operation_id",
        "status"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "https://autopw.dev/schemas/2.1/mcp-error-envelope.schema.json"
    }
  ],
  "creates_operation": false,
  "requires_client_request_id": false,
  "async_default": false,
  "retryable": true,
  "authorization_scope": [
    "workspace"
  ],
  "returns_max_bytes": 524288,
  "examples": {
    "request": [
      {
        "schema_version": "2.1",
        "workspace_id": "ws_demo",
        "operation_id": "op_0123456789abcdefghij"
      }
    ],
    "ok": [
      {
        "kind": "ok",
        "schema_version": "2.1",
        "operation_id": "op_0123456789abcdefghij",
        "status": "RUNNING",
        "label": "discovering",
        "poll_after_ms": 2000
      }
    ],
    "error": [
      {
        "kind": "error",
        "schema_version": "2.1",
        "error": {
          "code": "OPERATION_NOT_FOUND",
          "message": "operation id unknown or expired"
        },
        "retryable": false
      }
    ]
  }
}
