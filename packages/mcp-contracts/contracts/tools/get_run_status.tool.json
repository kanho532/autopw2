{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.dev/contracts/2.1/tools/get_run_status.tool.json",
  "name": "get_run_status",
  "description": "Query Run phase, run status, progress, recent events and recommended next action. Read-only; does not advance phase or resume.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://autopw.dev/contracts/2.1/tools/get_run_status.tool.json#/input",
    "title": "get_run_status input",
    "description": "Run status query",
    "type": "object",
    "properties": {
      "schema_version": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
      },
      "workspace_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/workspaceId"
      },
      "run_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/runId"
      }
    },
    "required": [
      "schema_version",
      "workspace_id",
      "run_id"
    ],
    "additionalProperties": false
  },
  "result_union": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "ok"
        },
        "schema_version": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
        },
        "run_id": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/runId"
        },
        "phase": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/runPhase"
        },
        "run_status": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/runStatus"
        },
        "audit_status": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/auditStatus"
        },
        "gate": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/gate"
        },
        "progress_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "next_action": {
          "type": "string",
          "description": "recommended next action"
        },
        "poll_after_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "stale": {
          "type": "boolean"
        },
        "interrupted": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "run_id",
        "phase",
        "run_status",
        "next_action",
        "poll_after_ms"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "https://autopw.dev/schemas/2.1/mcp-error-envelope.schema.json"
    }
  ],
  "creates_operation": false,
  "requires_client_request_id": false,
  "async_default": false,
  "retryable": true,
  "authorization_scope": [
    "workspace"
  ],
  "returns_max_bytes": 524288,
  "examples": {
    "request": [
      {
        "schema_version": "2.1",
        "workspace_id": "ws_demo",
        "run_id": "run_0123456789abcdefghij"
      }
    ],
    "ok": [
      {
        "kind": "ok",
        "schema_version": "2.1",
        "run_id": "run_0123456789abcdefghij",
        "phase": "RUNNING",
        "run_status": "ACTIVE",
        "progress_pct": 40,
        "next_action": "poll get_run_status",
        "poll_after_ms": 5000,
        "stale": false,
        "interrupted": false
      }
    ],
    "error": [
      {
        "kind": "error",
        "schema_version": "2.1",
        "error": {
          "code": "RUN_FORBIDDEN",
          "message": "handle not bound to this workspace"
        },
        "retryable": false
      }
    ]
  }
}
