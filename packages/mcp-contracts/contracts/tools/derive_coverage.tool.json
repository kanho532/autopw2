{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopw.dev/contracts/2.1/tools/derive_coverage.tool.json",
  "name": "derive_coverage",
  "description": "Preview coverage scope, skeleton, blockers, candidate summary and CDD Draft. Returns an accepted Operation; poll get_operation_status, then read get_operation_result.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://autopw.dev/contracts/2.1/tools/derive_coverage.tool.json#/input",
    "title": "derive_coverage input",
    "description": "Coverage preview request",
    "type": "object",
    "properties": {
      "schema_version": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
      },
      "client_request_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/clientRequestId"
      },
      "workspace_id": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/workspaceId"
      },
      "project_subpath": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/projectSubpath"
      },
      "profile_path": {
        "type": "string",
        "description": "relative profile path"
      },
      "tier": {
        "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/enum/baseTier"
      },
      "diff_ref": {
        "type": "string",
        "description": "git diff ref"
      },
      "auth_scope_id": {
        "type": "string",
        "description": "approved auth scope id reference"
      }
    },
    "required": [
      "schema_version",
      "client_request_id",
      "workspace_id"
    ],
    "additionalProperties": false
  },
  "result_union": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "accepted"
        },
        "schema_version": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/schemaVersion"
        },
        "operation_id": {
          "$ref": "https://autopw.dev/schemas/2.1/common.schema.json#/$defs/operationId"
        },
        "poll_after_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "required": [
        "kind",
        "schema_version",
        "operation_id",
        "poll_after_ms"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "https://autopw.dev/schemas/2.1/mcp-error-envelope.schema.json"
    }
  ],
  "creates_operation": true,
  "requires_client_request_id": true,
  "async_default": true,
  "retryable": true,
  "authorization_scope": [
    "workspace",
    "auth"
  ],
  "returns_max_bytes": 524288,
  "examples": {
    "request": [
      {
        "schema_version": "2.1",
        "client_request_id": "cr_abc123",
        "workspace_id": "ws_demo",
        "project_subpath": ".",
        "profile_path": ".autopw/profile.yaml",
        "tier": "fast",
        "diff_ref": "origin/main...HEAD"
      }
    ],
    "ok": [
      {
        "kind": "accepted",
        "schema_version": "2.1",
        "operation_id": "op_0123456789abcdefghij",
        "poll_after_ms": 2000
      }
    ],
    "error": [
      {
        "kind": "error",
        "schema_version": "2.1",
        "error": {
          "code": "UNAUTHORIZED_WORKSPACE",
          "message": "workspace not in host allowlist"
        },
        "retryable": false
      }
    ]
  }
}
