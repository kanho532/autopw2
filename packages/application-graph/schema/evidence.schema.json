{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autopw.dev/schema/evidence-1.0.json",
  "title": "AutoPW Evidence Collection 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence"],
  "properties": {
    "schema_version": { "const": "autopw.evidence/1.0" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "evidence_id", "source_fact_id", "fact_type", "source_kind", "source_ref", "confidence", "subject", "attributes"],
        "properties": {
          "schema_version": { "const": "autopw.evidence/1.0" },
          "evidence_id": { "type": "string", "pattern": "^evidence_[a-f0-9]{16}$" },
          "source_fact_id": { "type": "string", "minLength": 1 },
          "fact_type": { "type": "string", "minLength": 1 },
          "source_kind": { "enum": ["OPENAPI", "AST", "RUNTIME", "DOM", "REGEX", "MANUAL", "INFERRED"] },
          "source_ref": { "type": "object" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": { "kind": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 } }
          },
          "attributes": { "type": "object" }
        }
      }
    }
  }
}
