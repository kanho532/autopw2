{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autopw.dev/schema/graph-diagnostics-1.0.json",
  "title": "AutoPW Graph Diagnostics 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "diagnostics"],
  "properties": {
    "schema_version": { "const": "autopw.graph-diagnostics/1.0" },
    "graph_id": { "type": "string", "pattern": "^graph_[a-f0-9]{16}$" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["diagnostic_id", "code", "severity", "message", "subject_refs", "evidence_refs"],
        "properties": {
          "diagnostic_id": { "type": "string", "pattern": "^diagnostic_[a-f0-9]{16}$" },
          "code": { "enum": ["CONFLICTING_OPERATION_EVIDENCE", "AMBIGUOUS_FIELD_RESOURCE", "WEAK_ASSOCIATION", "UNLINKED_CORRELATION", "UNLINKED_WORKFLOW_OPERATION"] },
          "severity": { "enum": ["warning", "error"] },
          "message": { "type": "string", "minLength": 1 },
          "subject_refs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^evidence_[a-f0-9]{16}$" }, "uniqueItems": true }
        }
      }
    }
  }
}
